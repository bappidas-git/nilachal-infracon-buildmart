# exposed — they MUST be rotated during and after the rebuild series before
# the site goes live.
# ============================================

# Application
REACT_APP_NAME="Nilachal Infracon"

# Admin Panel Credentials (rotate before any deploy)
REACT_APP_ADMIN_USERNAME="nilachaladmin"
REACT_APP_ADMIN_PASSWORD="PMMqlKXYjZzTgAU9bUAosp5p"

# Contact Information
REACT_APP_SALES_PHONE="+91-8638543526"
REACT_APP_WHATSAPP_NUMBER="+918638543526"
REACT_APP_SALES_EMAIL="info@nilachalinfracon.com"

# Hero Video (set URL to enable hero background video)
REACT_APP_HERO_VIDEO_URL=""

# Lead Storage (server-side single source of truth)
REACT_APP_LEADS_API_URL="/api/leads.php"
REACT_APP_LEADS_ADMIN_KEY="skdfjsdfweiormcnzxmzdlkfjds"

# Tele-Calling store (telecaller-entered leads). Reuses REACT_APP_LEADS_ADMIN_KEY
# for auth. Same-origin by default. (Module removed in prompt 13.)
REACT_APP_TELECALLS_API_URL="/api/telecalls.php"

# ============================================
# Leads are stored server-side via /api/leads.php (the single source of truth).
# The admin panel reads/writes leads there so every browser/device stays in
# sync. REACT_APP_LEADS_API_URL + REACT_APP_LEADS_ADMIN_KEY (above) configure it.
# ============================================
