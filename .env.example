# ============================================
# Environment Variables — Example / Template
# Nilachal Infracon Private Limited
# ============================================
# Copy this file to .env and fill in the values.
#
# NOTE: In this repo .env is committed to git (existing agency workflow), so
# treat every secret as versioned — set strong values and rotate them before
# the site goes live.
# ============================================

# Application
REACT_APP_NAME="Nilachal Infracon"

# Admin Panel Credentials — set a strong username and a 16+ character password
REACT_APP_ADMIN_USERNAME="nilachaladmin"
REACT_APP_ADMIN_PASSWORD=""

# Contact Information
REACT_APP_SALES_PHONE="+91-8638543526"
REACT_APP_WHATSAPP_NUMBER="+918638543526"
REACT_APP_SALES_EMAIL="info@nilachalinfracon.com"

# Hero Video (set URL to enable hero background video)
REACT_APP_HERO_VIDEO_URL=""

# ============================================
# Lead Storage (Admin Panel) — REQUIRED
# ============================================
# Leads are stored on your server so every admin sees every lead, from every
# device. Set these in tandem with public/api/config.php.
#
# URL of the leads API endpoint. Leave as default unless leads.php lives on a
# different domain (then use the full URL).
REACT_APP_LEADS_API_URL="/api/leads.php"
# Shared secret used to list/update/delete leads from the admin panel.
# MUST EXACTLY match ADMIN_API_KEY defined in public/api/config.php.
# Generate a long random string.
REACT_APP_LEADS_ADMIN_KEY=""
